# ==========================================
# ToolStaq Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env or .env.local to Git.
# ==========================================

# Supabase Configuration (Client Public)
# Allowed client-side ONLY if Row Level Security (RLS) is enforced on all tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (SERVER ONLY - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email API Configuration (SERVER ONLY)
RESEND_API_KEY=re_your_resend_api_key
RESEND_AUDIENCE_ID=your_resend_audience_id
RESEND_FROM_EMAIL=ToolStaq <newsletter@yourdomain.com>

# Cron Job Secret (SERVER ONLY)
# Used to authenticate scheduled cron triggers (e.g. /api/cron/newsletter?secret=...)
CRON_SECRET=your_random_cron_secret_token

# Currents AI / External News API (SERVER ONLY)
CURRENTS_API_KEY=your_currents_api_key

# PostHog Analytics Configuration (Client Public)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

